# 戦女神VERITA: save on SC0000's fourth page, read on, and load the save back. Unchanged on both targets, on a fresh
# sandbox (the default). It is the scenario of the game's save gate (docs/adding-a-game.md, step 7): native AGE and
# the port both pass it since 2026-11-25, each loads the other's save, and save-diff shows only the time stamp between
# their saves.
#   py -3.11 -X utf8 tools/drive.py --game verita native|port start
#   py -3.11 -X utf8 tools/drive.py --game verita native|port run tools/drive/scenarios/verita-save-load.steps
#   py -3.11 -X utf8 tools/drive.py --game verita native|port stop
# The save is SAVE00.DAT in the sandbox's SAVE folder. Compare two targets' files with
#   Ome.Cli save-diff A/SAVE00.DAT B/SAVE00.DAT --game verita
# Seed a new sandbox from the other target's (--seed native:fresh or port:fresh, after that target has stopped, since
# the shared SAVE.DAT is written when the game closes) to load one target's save on the other.
# The right click opens the character menu (MENU); its Data Save and Data Load open the DATA SAVE page (SAVE), and a
# slot asks its question in SBUNKI. A save returns to the menu; a load resumes the saved page.

rand-seed 13
wait-state script=TITLE timeout=120
wait 6
click title.start
wait-state top=SC0000@0xa2d timeout=90  # page 1
settle timeout=20
advance 1
expect top=SC0000@0xa49                 # page 2
advance 1                               # a timed transition of three seconds follows
wait-state top=SC0000@0xaf7 timeout=30  # page 3
settle timeout=20
advance 1
expect top=SC0000@0xb46                 # page 4
shot verita-save-page4

rclick adv.next                         # the character menu
wait-state script=MENU timeout=20
wait 1.5
click menu.save
wait-state script=SAVE timeout=20
wait 1.5
click slot.0
wait 2
click confirm.yes
settle timeout=20                       # the question box moves away (SBUNKIMOVE) and the menu returns
wait 1.5
click menu.close
wait-state top=SC0000@0xb46 timeout=20
settle timeout=20

advance 2
expect top=SC0000@0xb7e                 # page 6
rclick adv.next
wait-state script=MENU timeout=20
wait 1.5
click menu.load
wait-state script=SAVE timeout=20
wait 1.5
click slot.0
wait 2
click confirm.yes
wait-state top=SC0000@0xb46 timeout=60  # the load resumes page 4
settle timeout=20
shot verita-save-loaded
