# 戦女神ZERO: save on SC0000's fourth page, read on, and load the save back. Unchanged on both targets, on a fresh
# sandbox (the default). It is the scenario of the game's save gate (docs/adding-a-game.md, step 7).
#   py -3.11 -X utf8 tools/drive.py --game bg0 native|port start
#   py -3.11 -X utf8 tools/drive.py --game bg0 native|port run tools/drive/scenarios/bg0-save-load.steps
#   py -3.11 -X utf8 tools/drive.py --game bg0 native|port stop
# The save is SAVE00.DAT, with its picture SAVE00.STH, in the sandbox's SAVE folder. Compare two targets' files with
#   Ome.Cli save-diff A/SAVE00.DAT B/SAVE00.DAT --game bg0
# Seed a new sandbox from the other target's (--seed native:fresh or port:fresh, after that target has stopped) to load
# one target's save on the other.
# A right click opens the character menu (MENU) and another closes it; its SAVE and LOAD open the slot page (SAVE), and
# a slot asks its question in SBUNKI. A save returns to the menu; a load resumes the saved page.

rand-seed 13
wait-state script=OP timeout=120
wait 3
click adv.next                           # ends the opening movie
wait-state script=TITLE timeout=60
settle timeout=20
click title.start
wait-state script=BUNKI timeout=60
settle timeout=20
click mode.normal
wait-state top=SC0000@0xec7 timeout=60   # page 1
settle timeout=20
advance 1
expect top=SC0000@0xefc                  # page 2
advance 1
expect top=SC0000@0x1175                 # page 3
advance 1
expect top=SC0000@0x13e9                 # page 4
shot bg0-save-page4

rclick adv.next                          # the character menu
wait-state script=MENU timeout=20
wait 1.5
click menu.save
wait-state script=SAVE timeout=20
wait 1.5
click slot.0
wait-state script=SBUNKI timeout=20
wait 1
click confirm.yes
settle timeout=30                        # the save returns to the menu, idling in its sleep loop: native
                                         # reports MENU@0x190, at the sleep, and the port MENU@0x193, past it
wait 1.5
rclick adv.next                          # closes it, which only the menu does
wait-state top=SC0000@0x13e9 timeout=20
settle timeout=20

advance 2
expect top=SC0000@0x1ab3                 # page 6
rclick adv.next
wait-state script=MENU timeout=20
wait 1.5
click menu.load
wait-state script=SAVE timeout=20
wait 1.5
click slot.0
wait-state script=SBUNKI timeout=20
wait 1
click confirm.yes
wait-state top=SC0000@0x13e9 timeout=60  # the load resumes page 4
settle timeout=20
shot bg0-save-loaded
