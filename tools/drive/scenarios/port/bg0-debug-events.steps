# Port only (scenarios/port/): 戦女神ZERO's base mod in play (docs/adding-a-game.md, M3). Three example mods:
# example.bg0-debug-menu opens the title's debug menu from Quit, example.bg0-map-block edits map 1's block 50 at
# bg0.map.loaded, and example.bg0-event-log lists every event of bg0-base, and gives one 治癒の水・小 at
# bg0.data.ready through the base mod's helper. The debug menu's 迷宮マップ（ＰＧ１用） (DEBUGMAP2) joins the party,
# gives character 53 999,999 experience through ADDEXP (DEBUGMAP2@0x8f), which takes it from level 67 to 310, and
# starts FIELD on map 1 at row 1, column 20. (The 999,999 on セリカ's panel DEBUGMAP2@0x8 writes itself.)
# Run on a fresh sandbox:
#   py -3.11 -X utf8 tools/drive.py --game bg0 port start --mod oms/examples/mods/example.bg0-debug-menu --mod oms/examples/mods/example.bg0-map-block --mod oms/examples/mods/example.bg0-event-log
#   py -3.11 -X utf8 tools/drive.py --game bg0 port run tools/drive/scenarios/port/bg0-debug-events.steps
#   py -3.11 -X utf8 tools/drive.py --game bg0 port stop

rand-seed 13
wait-state script=OP timeout=120
wait 3
click adv.next                          # ends the opening movie
wait-state script=TITLE timeout=60
settle timeout=20
click title.quit                        # the debug menu
wait 2
settle timeout=20
shot bg0-debug-menu
click 370 383                           # 迷宮マップ（ＰＧ１用）
wait-state script=FIELD timeout=90
wait 3
settle timeout=30
lua local t = maid.names.table("map_block_music") assert(t[50][0] == 14 and t[91][0] == 21, t[50][0] .. " " .. t[91][0]) return t[50][0]
lua mod=example.bg0-event-log local log = table.concat(seen, "; ") assert(log == "bg0.data.layered; bg0.data.ready item101=1; bg0.experience.award character=53 amount=999999 level=67; bg0.map.loaded map=1", log) return log
shot bg0-debug-map
