# Port only (scenarios/port/): 天秤のLa DEA。's experience award from a battle (docs/adding-a-game.md, M3), with the
# example mods example.ladea-debug-menu and example.ladea-event-log. The debug menu's 迷宮マップ２ (DEBUGFIELD2) opens
# floor 65 with the 15 party characters at level 215 or more; the field's 索敵 starts a battle there, and AUTO戦闘 wins
# it. RESULT then shares the battle's experience among the party (RESULT@0x6d6): 620 to each of the five in battle and
# 210 to each in reserve. ADDEXP raises ladea.experience.award only for a character below the cap, so リザイラ, at 250,
# has none: fourteen awards, after the debug entry's sixteen.
# Run on a fresh sandbox:
#   py -3.11 -X utf8 tools/drive.py --game ladea port start --mod oms/examples/mods/example.ladea-debug-menu --mod oms/examples/mods/example.ladea-event-log
#   py -3.11 -X utf8 tools/drive.py --game ladea port run tools/drive/scenarios/port/ladea-battle-award.steps
#   py -3.11 -X utf8 tools/drive.py --game ladea port stop

rand-seed 13
wait-state script=TITLE timeout=120
settle timeout=20
click title.quit                        # the debug menu
wait 2
settle timeout=20
expect script=BUNKI
click 640 475                           # 迷宮マップ２
wait-state script=FIELD timeout=180
wait 3
settle timeout=60
lua mod=example.ladea-event-log assert(#seen == 19 and seen[#seen] == "ladea.floor.loaded floor=65", #seen .. " " .. seen[#seen]) return #seen
click 460 50                            # 索敵
wait-state script=SELACT timeout=60
settle timeout=30
shot ladea-battle
click 35 35                             # AUTO戦闘
wait-state script=RESULT timeout=300
wait 3
settle timeout=30
lua mod=example.ladea-event-log local award = {} for i = 20, #seen do award[#award + 1] = seen[i]:gsub("^ladea%.experience%.award ", "") end local log = table.concat(award, "; ") assert(log == "character=1 amount=620 level=215; character=3 amount=620 level=215; character=5 amount=620 level=216; character=23 amount=620 level=215; character=31 amount=620 level=215; character=32 amount=210 level=215; character=46 amount=210 level=216; character=40 amount=210 level=221; character=70 amount=210 level=226; character=53 amount=210 level=215; character=66 amount=210 level=216; character=51 amount=210 level=216; character=47 amount=210 level=217; character=50 amount=210 level=217", log) return log
shot ladea-battle-award
