# Port only (scenarios/port/): 天秤のLa DEA。's base mod in play (docs/adding-a-game.md, M3). Three example mods:
# example.ladea-debug-menu opens the title's debug menu from Quit, example.ladea-floor-chest fills floor 65's chest in
# slot 8 at ladea.floor.loaded, and example.ladea-event-log lists every event of ladea-base, and gives one 治癒の水・小
# at ladea.data.ready through the base mod's helper. The debug menu's 迷宮マップ２ (DEBUGFIELD2) runs INITGAME, joins
# the 15 party characters, gives each 10,000,000 experience through ADDEXP (character 62 twice), gives items, and opens
# the dungeon on floor 65, at map block 657.
# Run on a fresh sandbox:
#   py -3.11 -X utf8 tools/drive.py --game ladea port start --mod oms/examples/mods/example.ladea-debug-menu --mod oms/examples/mods/example.ladea-floor-chest --mod oms/examples/mods/example.ladea-event-log
#   py -3.11 -X utf8 tools/drive.py --game ladea port run tools/drive/scenarios/port/ladea-debug-field.steps
#   py -3.11 -X utf8 tools/drive.py --game ladea port stop

rand-seed 13
wait-state script=TITLE timeout=120
settle timeout=20
lua mod=example.ladea-event-log local log = table.concat(seen, "; ") assert(log == "ladea.data.layered; ladea.data.ready item201=1", log) return log
click title.quit                        # the debug menu
wait 2
settle timeout=20
expect script=BUNKI
shot ladea-debug-menu
click 640 475                           # 迷宮マップ２
wait-state script=FIELD timeout=180
wait 3
settle timeout=60
lua mod=example.ladea-event-log local n = 0 for _, line in ipairs(seen) do if line:find("^ladea%.experience%.award .* amount=10000000 ") then n = n + 1 end end assert(n == 16, n) return n
lua mod=example.ladea-event-log assert(seen[#seen] == "ladea.floor.loaded floor=65", seen[#seen]) return seen[#seen]
lua local g = maid.vm.g assert(maid.names.g.current_floor_id == 65 and g[0xca2981 + 24] == 201 and g[0xca2981 + 25] == 9, g[0xca2981 + 24] .. " " .. g[0xca2981 + 25]) return g[0xca2981 + 24] .. " " .. g[0xca2981 + 25]
shot ladea-debug-field
