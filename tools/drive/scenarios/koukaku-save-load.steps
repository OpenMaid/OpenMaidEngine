# 魔導巧殻: save on SC0000's fourth page, read on, and load the save back. Unchanged on both targets, on a fresh
# sandbox (the default). It is the scenario of the game's save gate (docs/adding-a-game.md, step 7).
#   py -3.11 -X utf8 tools/drive.py --game koukaku native|port start
#   py -3.11 -X utf8 tools/drive.py --game koukaku native|port run tools/drive/scenarios/koukaku-save-load.steps
#   py -3.11 -X utf8 tools/drive.py --game koukaku native|port stop
# The save is SAVE00.DAT in the sandbox's SAVE folder. Compare two targets' files with
#   Ome.Cli save-diff A/SAVE00.DAT B/SAVE00.DAT --game koukaku
# Seed a new sandbox from the other target's (--seed native:fresh or port:fresh, after that target has stopped, since
# the shared SAVE.DAT is written when the game closes) to load one target's save on the other: run the scenario's
# second half (from "# Load") alone after the opening.

rand-seed 13
wait-state script=TITLE timeout=120
settle timeout=20
click title.start
wait-state script=GAMESTART timeout=60
settle timeout=20
click start.begin
wait-state top=SC0000@0xe7e timeout=240  # the PROLOGUE movie plays to its end
wait-state top=SC0000@0xef2 timeout=60   # page 1
settle timeout=30
advance 3
expect top=SC0000@0xf9e                  # page 4
shot koukaku-save-page4

rclick adv.next                          # the ADV menu
wait-state script=MENU timeout=20
wait 1.5
click menu.save
wait-state script=SAVE timeout=20
wait 1.5
click slot.0
wait-state script=SBUNKI timeout=20      # セーブしますか？
wait 1.5
click confirm.yes
wait-state script=SAVE timeout=20        # the slot shows the save
wait 1.5
shot koukaku-save-slot
rclick adv.next                          # back to the page
wait-state top=SC0000@0xf9e timeout=20
settle timeout=20

advance 2
# Load
rclick adv.next
wait-state script=MENU timeout=20
wait 1.5
click menu.load
wait-state script=SAVE timeout=20
wait 1.5
click slot.0
wait-state script=SBUNKI timeout=20      # ロードしますか？
wait 1.5
click confirm.yes
wait-state top=SC0000@0xf9e timeout=60   # the load resumes page 4
settle timeout=20
shot koukaku-save-loaded
