// One ADV page (spec §11.2). G[0x348a]: the page has text; G[0x3489]: the current speaker (-1 for narration),
// whose name show_speaker draws from CNINIT's names (GS[0x1b6]). Every spoken page in the scenes is voiced; its
// voice is muted when the option for the speaker's voice is off (G[0x30a0]).
@dialogue inline line(text: text, speaker: speaker = none, voice: const = none) {
    reset_adv_text_layout(0x1)
    G[0x348a] = 0x1
    begin_page_voice()
    static if speaker == none {
        atomic {
            clear_speaker()
            arm_voice_duck_release()
        }
    } else {
        begin_window_transition()
        G[0x3489] = speaker
        show_speaker()
        present_window_transition()
        static if voice != none {
            if G[0x3489] < 0x0 {
                mute_next_voice()
            } else if G[0x30a0][G[0x268f74][G[0x268b8c][G[0x3489]]]] {
                mute_next_voice()
            }
            play_voice(voice)
        }
    }
    show_text(0x0, text)
    wait_for_input(0x0)
    end_text_line(0x0)
}

// The scene header's hotspot handlers: placed where each scene registers them, so the sidecar records their place.
sub register_adv_hotspots {
    atomic {
        if G[0x917] {
            register_hotspot_callbacks(0x3bc, 0x1b6, 0x3c, 0x44, skip_button_enter, skip_button_leave, skip_button_click)
            register_hotspot_callbacks(0x3d1, 0x202, 0x10, 0x10, history_button_enter, history_button_leave, history_button_click)
            register_hotspot_callbacks(0x3cb, 0x219, 0x1b, 0x1c, auto_button_enter, auto_button_leave, auto_button_click)
            register_hotspot_callbacks(0x3e8, 0x226, 0x10, 0x11, hide_button_enter, hide_button_leave, hide_button_click)
        }
        register_hotspot_callbacks(-(0x3e8), -(0x3e8), 0x1, 0x1, -1, -1, cursor_key_0)
        register_hotspot_callbacks(-(0x3e8), -(0x3e9), 0x1, 0x1, -1, -1, cursor_key_1)
        register_hotspot_callbacks(-(0x3e8), -(0x3ea), 0x1, 0x1, -1, -1, cursor_key_2)
        register_hotspot_callbacks(-(0x3e8), -(0x3eb), 0x1, 0x1, -1, -1, cursor_key_3)
        register_hotspot_callbacks(-(0x3e8), -(0x3f0), 0x1, 0x1, -1, -1, cursor_key_8)
        bind_hotspot_key(-(0x3e8), -(0x3e8), 0x1, 0x1, 0x0)
        bind_hotspot_key(-(0x3e8), -(0x3e9), 0x1, 0x1, 0x1)
        bind_hotspot_key(-(0x3e8), -(0x3ea), 0x1, 0x1, 0x2)
        bind_hotspot_key(-(0x3e8), -(0x3eb), 0x1, 0x1, 0x3)
        bind_hotspot_key(-(0x3e8), -(0x3f0), 0x1, 0x1, 0x8)
        if G[0x262e7c] == 0x0 && G[0x427db0][G[0x269b30]] != 0x4 {
            register_hotspot_callbacks(-(0x3e8), -(0x3ef), 0x1, 0x1, -1, -1, cursor_key_7)
            bind_hotspot_key(-(0x3e8), -(0x3ef), 0x1, 0x1, 0x7)
        }
        arm_hotspot_wait()
    }
    return
}
sub skip_button_enter {
    atomic {
        G[0x91f] = 0x1
        G[0x268b22] = 0x1
        draw_message_window()
    }
    return
}
sub skip_button_leave {
    atomic {
        G[0x91f] = 0x0
        G[0x268b22] = 0x0
        gfx_elem_erase(0x2eea, 0x2)
    }
    return
}
sub skip_button_click {
    atomic {
        G[0x91f] = 0x0
        if G[0x3633] == 0x1 {
            G[0x268b1f] = get_read_message_skip()
            G[0x268b1f] = 0x1 - G[0x268b1f]
            set_read_message_skip(G[0x268b1f])
        } else {
            set_message_skip(0x1)
        }
        draw_message_window()
        sleep(0x64)
        reset_message_skip_input()
    }
    return
}
sub history_button_enter {
    atomic {
        G[0x920] = 0x1
        G[0x268b22] = 0x2
        draw_message_window()
    }
    return
}
sub history_button_leave {
    atomic {
        G[0x920] = 0x0
        G[0x268b22] = 0x0
        gfx_elem_erase(0x2eea, 0x2)
    }
    return
}
sub history_button_click {
    G[0x920] = 0x0
    gfx_elem_erase(0x2eea, 0x2)
    cancel_hotspot_wait()
    run HISTORY
    register_adv_hotspots()
    return
}
sub auto_button_enter {
    atomic {
        G[0x921] = 0x1
        G[0x268b22] = 0x3
        draw_message_window()
    }
    return
}
sub auto_button_leave {
    atomic {
        G[0x921] = 0x0
        G[0x268b22] = 0x0
        gfx_elem_erase(0x2eea, 0x2)
    }
    return
}
sub auto_button_click {
    atomic {
        G[0x91b] = get_auto_message()
        G[0x91b] = 0x1 - G[0x91b]
        set_auto_message(G[0x91b])
        draw_message_window()
    }
    return
}
sub hide_button_enter {
    atomic {
        G[0x922] = 0x1
        G[0x268b22] = 0x4
        draw_message_window()
    }
    return
}
sub hide_button_leave {
    atomic {
        G[0x922] = 0x0
        G[0x268b22] = 0x0
        gfx_elem_erase(0x2eea, 0x2)
    }
    return
}
sub hide_button_click {
    G[0x922] = 0x0
    gfx_elem_erase(0x2eea, 0x2)
    yield_adv_coroutine()
    cancel_hotspot_wait()
    register_adv_hotspots()
    return
}
sub cursor_key_0 {
    if G[0x917] {
        if G[0x91f] {
            set_cursor_virtual(0x3d9, 0x1a4)
        } else if G[0x920] {
            set_cursor_virtual(0x3d9, 0x1e6)
        } else if G[0x921] {
            set_cursor_virtual(0x3d9, 0x20a)
        } else if G[0x922] {
            set_cursor_virtual(0x3d9, 0x227)
        } else {
            goto cursor_key_8
        }
    } else {
        goto cursor_key_8
    }
    return
cursor_key_1:
    if G[0x917] {
        if G[0x91f] | G[0x920] | G[0x922] {
            get_cursor_virtual(out G[0x91d], out G[0x91e])
            set_cursor_virtual(G[0x91d], G[0x91e] + G[0x91c] * 0x2 - 0x1)
            G[0x91c] = 0x1 - G[0x91c]
            goto cursor_key_0_2
        }
        if G[0x921] {
            set_cursor_virtual(0x3f0, 0x22e)
            goto cursor_key_0_2
        }
        set_cursor_virtual(0x3d9, 0x1e6)
    }
cursor_key_0_2:
    return
cursor_key_2:
    if G[0x917] {
        if G[0x91f] {
            set_cursor_virtual(0x3d9, 0x20a)
            goto cursor_key_0_4
        }
        if G[0x920] {
            set_cursor_virtual(0x3d9, 0x227)
            goto cursor_key_0_4
        }
        if G[0x921] {
            set_cursor_virtual(0x3f0, 0x22e)
            goto cursor_key_0_4
        }
        if G[0x922] {
            get_cursor_virtual(out G[0x91d], out G[0x91e])
            set_cursor_virtual(G[0x91d], G[0x91e] + G[0x91c] * 0x2 - 0x1)
            G[0x91c] = 0x1 - G[0x91c]
            goto cursor_key_0_4
        }
        set_cursor_virtual(0x3d9, 0x1e6)
    }
cursor_key_0_4:
    return
cursor_key_3:
    if G[0x917] {
        if G[0x91f] | G[0x920] | G[0x921] {
            get_cursor_virtual(out G[0x91d], out G[0x91e])
            set_cursor_virtual(0x3ac, G[0x91e])
            goto cursor_key_0_6
        }
        if G[0x922] {
            set_cursor_virtual(0x3d9, 0x227)
            goto cursor_key_0_6
        }
        set_cursor_virtual(0x3d9, 0x1e6)
    }
cursor_key_0_6:
    return
cursor_key_7:
    atomic {
        G[0x91f] = 0x0
        G[0x920] = 0x0
        G[0x921] = 0x0
        G[0x922] = 0x0
        cancel_hotspot_wait()
    }
    if G[0x268b26] {
        GS[0x1157][G[0x27539b]] = set_string("シーン回想終了")
        G[0x27539d][G[0x27539b]] = G[0x27539b]
        G[0x275542] = G[0x27539b]
        G[0x27539b] += 0x1
        GS[0x1157][G[0x27539b]] = set_string("キャンセル")
        G[0x27539d][G[0x27539b]] = G[0x27539b]
        G[0x275542] = G[0x27539b]
        G[0x27539b] += 0x1
        G[0x275543] = 0x7
        run BUNKI
        if G[0x27539c] == 0x0 {
            exit
        }
    } else {
        run MENU
    }
    register_adv_hotspots()
    return
cursor_key_8:
    atomic {
        G[0x91f] = 0x0
        G[0x920] = 0x0
        G[0x921] = 0x0
        G[0x922] = 0x0
        cancel_hotspot_wait()
    }
    run HISTORY
    register_adv_hotspots()
    return
}
coroutine adv_hide_window_handler {
    begin_window_transition()
    G[0x915] = 0x1
    draw_message_window()
    G[0x915] = 0x0
    G[0x268b63] = 0x1f4
    fade_message_window()
    G[0x268b67] = 0x1
    present_window_transition()
    cancel_hotspot_wait()
    run HIDEWIN
    if G[0x268b29] {
        atomic {
            draw_message_window()
            publish_message_text()
            present_frame()
            G[0x268b29] = 0x0
        }
    }
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    mark_save_resume_frame()
    yield_adv_coroutine()
    resume
}
coroutine adv_show_window_handler {
    begin_window_transition()
    G[0x915] = 0x1
    draw_message_window()
    G[0x915] = 0x1
    G[0x268b63] = 0x1f4
    fade_message_window()
    G[0x268b67] = 0x1
    G[0x348a] = 0x1
    present_window_transition()
    resume
}

// Library functions: linked after the scene behind an exit guard, breadth first in order of first reference.
@guard sub draw_message_window {
    gfx_elem_erase(0x2ee0, 0x4)
    gfx_elem_erase(0x2eea, 0x2)
    if G[0x915] {
        draw_texture(0x2ee0, 0x11, 0x0, 0x0, 0x400, 0xaa, 0x0, 0x196)
        G[0x919] = get_message_window_alpha()
        gfx_draw_color(0x2ee0, 0x0, 0x10 - G[0x919] << 0x4, G[0x913])
        draw_texture(0x2ee0 + 0x1, 0x11, 0x0, 0xaa, 0xa9, 0xd6, 0x357, 0x167)
        if G[0x917] {
            G[0x268b1e] = get_message_skip_enabled()
            G[0x268b1f] = get_read_message_skip()
            G[0x268b7e] = G[0x268b1e] | G[0x268b1f]
            G[0x268b7f] = get_auto_message()
            if G[0x268b7e] {
                draw_texture(0x2ee0 + 0x2, 0x11, 0xfc, 0x104, 0xa0, 0xf, 0x310, 0x1bb)
            }
            if G[0x268b7f] {
                draw_texture(0x2ee0 + 0x3, 0x11, 0xfc, 0x113, 0xa0, 0xf, 0x310, 0x1cf)
            }
            if G[0x91f] {
                draw_texture(0x2eea, 0x11, 0xa9, 0xaa, 0x53, 0xab, 0x3ab, 0x168)
                draw_texture(0x2eea + 0x1, 0x11, 0xfc, 0xc8 + G[0x268b7e] * 0xf, 0xa0, 0xf, 0x310, 0x22d)
                goto draw_message_window_1
            }
            if G[0x920] {
                draw_texture(0x2eea, 0x11, 0xd5, 0x155, 0x10, 0x10, 0x3d1, 0x202)
                draw_texture(0x2eea + 0x1, 0x11, 0xfc, 0xaa, 0xa0, 0xf, 0x310, 0x22d)
                goto draw_message_window_1
            }
            if G[0x921] {
                draw_texture(0x2eea, 0x11, 0xa9, 0x155, 0x1b, 0x1c, 0x3cb, 0x219)
                draw_texture(0x2eea + 0x1, 0x11, 0xfc, 0xe6 + G[0x268b7f] * 0xf, 0xa0, 0xf, 0x310, 0x22d)
                goto draw_message_window_1
            }
            if G[0x922] {
                draw_texture(0x2eea, 0x11, 0xc4, 0x155, 0x11, 0x12, 0x3e8, 0x226)
                draw_texture(0x2eea + 0x1, 0x11, 0xfc, 0xb9, 0xa0, 0xf, 0x310, 0x22d)
            }
        }
    }
draw_message_window_1:
    return
}
@guard sub begin_window_transition {
    atomic {
        return
        exit
    fade_message_window:
        if G[0x915] {
            G[0x919] = get_message_window_alpha()
            gfx_blit_color(0x2ee0, 0x0, G[0x268b63], 0x10 - G[0x919] << 0x4, G[0x913])
            gfx_draw_color(0x2ee0, 0x0, 0x0, G[0x913])
            for G[0x268b3b] = 0x2ee0 + 0x1; G[0x268b3b] <= 0x2eea + 0x1; G[0x268b3b] += 0x1 {
                G[0x268b3c] = op_0x215(G[0x268b3b])
                if G[0x268b3c] >= 0x0 {
                    gfx_blit_color(G[0x268b3b], 0x0, G[0x268b63], 0xff, 0xffffff)
                    gfx_draw_color(G[0x268b3b], 0x0, 0x0, 0xffffff)
                }
            }
            goto begin_window_transition_2
        }
        gfx_blit_color(0x2ee0, 0x0, G[0x268b63], 0x0, G[0x913])
        for G[0x268b3b] = 0x2ee0 + 0x1; G[0x268b3b] <= 0x2eea + 0x1; G[0x268b3b] += 0x1 {
            G[0x268b3c] = op_0x215(G[0x268b3b])
            if G[0x268b3c] >= 0x0 {
                gfx_blit_color(G[0x268b3b], 0x0, G[0x268b63], 0x0, 0xffffff)
            }
        }
    begin_window_transition_2:
        gfx_elem_erase(0x3264, 0x1)
        clear_message_text()
        return
        exit
    present_window_transition:
        set_tick_presentation(0x1)
