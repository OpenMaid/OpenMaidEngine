oms 1
// 天秤のLa DEA。 ADV prelude (spec §11.2): the speaker table, the dialogue line template, the scene header's handlers
// and the library its scenes link. Drafted 2026-11-26 from the core decompile of every SC and SP scene: the header
// from SC0000 (all 188 scenes carry it unchanged), each library sub from the first scene that links it. Its library
// is 魔導巧殻's, and the subs the two share take koukaku.adv's names; the families that differ only in a duration
// carry it in their names. Maintained by hand since.
module ladea.adv
use ladea.scripts

// Speaker ids: the index into CHINIT's names (GS[0xc4a4:0x4], a row of four name forms per character), the ones the
// scenes set. Names that are not identifiers, or that two ids share, carry their id.
enum speaker {
    セリカ = 0x1
    ハイシェラ = 0x2
    シュリ = 0x3
    サリア = 0x4
    ロカ = 0x5
    グロック = 0x6
    クーン = 0x7
    リンシャ = 0x8
    アリシア = 0xb
    ゼン = 0xe
    ヨルマ = 0x12
    ルドーン = 0x13
    カウラ = 0x17
    エクト = 0x18
    ニウ = 0x1a
    ラクチェ = 0x1b
    レヴィア = 0x1f
    レフィン = 0x20
    ランザブ = 0x21
    サガモア = 0x22
    ローレン = 0x23
    カチュア = 0x24
    ラティナ = 0x27
    アビルース = 0x28
    ウェンディス = 0x29
    ハレッガ = 0x2a
    マチス = 0x2b
    ドルジス = 0x2c
    ルー = 0x2e
    speaker_0x2f = 0x2f  // リ・クアルー
    メルヤ = 0x30
    イルザーブ = 0x32
    メティサーナ = 0x33
    サウルーレ = 0x34
    リリエム = 0x35
    ヘルトマイト = 0x38
    フラロウス = 0x3b
    シュヴェルトライテ = 0x3c
    イルン = 0x3d
    リザイラ = 0x3e
    バルディエル = 0x3f
    ムールムール = 0x40
    ヴァレフォル = 0x42
    エウシュリーちゃん = 0x46
    Ｂエウシュリーちゃん = 0x47
    アナスタシア = 0x48
    エウクレイアさん = 0x49
    果物屋 = 0x64
    レニ = 0x65
    ミルフェ衛兵団員 = 0x69
    子供Ａ = 0x6b
    子供Ｂ = 0x6c
    ティント = 0x6d
    老人 = 0x70
    街の住民Ａ = 0x71
    街の住民Ｂ = 0x72
    街の住民Ｃ = 0x73
    ミルモ = 0x75
    speaker_0x76 = 0x76  // レウィニア騎士
    貴族軍騎士 = 0x77
    貴族軍傭兵 = 0x78
    闇混の魔術師 = 0x7a
    山賊 = 0x7c
    黒狐団 = 0x7d
    トールレント兵 = 0x7e
    speaker_0x80 = 0x80  // レウィニア騎士
    speaker_0x81 = 0x81  // レウィニア騎士
    男 = 0xc8
    中年の店員 = 0xc9
    店の客 = 0xca
    エルフ = 0xcc
    エルフの娘 = 0xcd
    エルフの長老 = 0xd0
    柄の悪い酔客 = 0xd2
    店の客Ｄ = 0xd3
    娼婦 = 0xd5
    ヤニス = 0xdc
    アムドシアス = 0xe7
    オリヴド = 0x12d
    ナラウク = 0x12e
    エルモン = 0x12f
}

// One ADV page (spec §11.2). G[0x3a47]: the page has text. G[0x3a46] is the speaker (-1 for narration); the page
// draws its name from the speaker's row of CHINIT's names in the name form G[0x3a49] (a column 0 to 3; another value
// shows ？？？？; the scenes' few pages in form -1 stay core statements) and its face from the picture G[0xcf2f5] (-1
// when the page passes none). G[0xcf2f6] is the page's voice, on voice channel 0, muted when the option for the
// speaker's voice character is off (G[0x365d]). A background voice (start_background_voice, G[0xcf27c]) keeps
// channel 2 playing across pages. Pages with more than one line, ruby or another voice channel stay core statements.
@dialogue inline line(text: text, speaker: speaker = none, face: const = none, voice: const = none, form: const = 0x0) {
    set_tick_presentation(0x0)
    reset_adv_text_layout(0x2)
    reset_adv_text_layout(0x1)
    G[0x3a47] = 0x1
    begin_page_voice()
    static if speaker == none {
        atomic {
            clear_speaker_face()
            clear_speaker()
            if G[0x6e62] == 0x1 || G[0xcf27c] == 0x0 {
                arm_voice_duck_release()
            }
            set_tick_presentation(0x1)
        }
    } else {
        atomic {
            G[0x3a46] = speaker
            G[0x3a49] = form
            static if face == none {
                G[0xcf2f5] = -(0x1)
            } else {
                G[0xcf2f5] = face
            }
            set_speaker_face()
            show_speaker()
            set_tick_presentation(0x1)
        }
    }
    static if voice != none {
        atomic {
            stop_voice(0x0)
            stop_voice(0x1)
            if G[0xcf27c] == 0x0 {
                stop_voice(0x2)
            }
            set_voice_pan(0x0, 0x0)
            G[0xcf2eb] = get_message_skip()
            G[0xcf2ec] = get_adv_read_skip_state()
            if G[0xcf2eb] | G[0xcf2ec] {
                stop_voice(0x0)
                stop_voice(0x1)
                if G[0xcf27c] == 0x0 {
                    stop_voice(0x2)
                }
            }
            if G[0x3a46] < 0x0 {
                set_voice_bgm_duck_control(0x10001)
            } else {
                set_voice_bgm_duck_control(0x0)
            }
            if G[0x3a46] < 0x0 {
                G[0x15765e] = 0x0
            } else if G[0x157a47][G[0x15765f][G[0x3a46]]] {
                G[0x15765e] = G[0x157a47][G[0x15765f][G[0x3a46]]]
            } else if G[0x1591ba][G[0x3a46]] == 0x2 {
                G[0x15765e] = 0x2
            } else {
                G[0x15765e] = 0x1
            }
            G[0xcf36c] = G[0x15765e]
            G[0xcf2f6] = voice
            append_text_history_metadata(0x4 + 0x0, G[0xcf36c])
            append_text_history_metadata(0x7 + 0x0, G[0xcf2f6])
            if G[0x365d][G[0xcf36c]] == 0x0 {
                if G[0xcf2eb] | G[0xcf2ec] {
                    set_voice_bgm_duck_control(0x10001)
                    mute_next_voice_n(0x0)
                    G[0xcf2f6] = 0x0
                }
            } else {
                mute_next_voice_n(0x0)
                G[0xcf2f6] = 0x0
            }
            if G[0xcf2f6] {
                play_voice(G[0xcf2f6])
            }
        }
    }
    show_text(0x0, text)
    wait_for_input(0x0)
    end_text_line(0x0)
}

// The scene header's hotspot handlers and window coroutines: placed where each scene registers them, so the sidecar
// records their place. The pin button (G[0xed6]) keeps the button bar open: while it is set, the screen's hotspot that
// collapses the bar is not registered.
sub register_adv_hotspots {
    atomic {
        if G[0xed5] == 0x2 {
            if G[0xcf2f8] == 0x0 {
                if (G[0x3a5e] & 0x1) == 0x0 {
                    register_hotspot_callbacks(0x4aa, 0x227, 0x50, 0x11, quick_save_button_enter, quick_save_button_leave, quick_save_button_click)
                }
                register_hotspot_callbacks(0x4aa, 0x23c, 0x50, 0x11, quick_load_button_enter, quick_load_button_leave, quick_load_button_click)
            }
            register_hotspot_callbacks(0x4aa, 0x251, 0x50, 0x11, auto_button_enter, auto_button_leave, auto_button_click)
            register_hotspot_callbacks(0x4aa, 0x266, 0x50, 0x11, read_skip_button_enter, read_skip_button_leave, read_skip_button_click)
            register_hotspot_callbacks(0x4aa, 0x27b, 0x50, 0x11, skip_button_enter, skip_button_leave, skip_button_click)
            register_hotspot_callbacks(0x4aa, 0x290, 0x50, 0x11, history_button_enter, history_button_leave, history_button_click)
            register_hotspot_callbacks(0x4be, 0x2a6, 0x3c, 0x10, pin_button_enter, pin_button_leave, pin_button_click)
            register_hotspot_callbacks(0x474, 0x2b1, 0x1a, 0x1a, hide_button_enter, hide_button_leave, hide_button_click)
            register_hotspot_callbacks(0x49c, 0x213, 0x64, 0xb0, expand_button_bar, ignore_button_bar, ignore_button_bar)
            if G[0xed6] == 0x0 {
                register_hotspot_callbacks(0x0, 0x0, 0x500, 0x2d0, collapse_button_bar, collapse_button_bar_1, collapse_button_bar_1)
            }
        } else if G[0xed5] == 0x1 {
            register_hotspot_callbacks(0x474, 0x2b1, 0x1a, 0x1a, hide_button_enter, hide_button_leave, hide_button_click)
            register_hotspot_callbacks(0x4d2, 0x213, 0x2e, 0xb0, expand_button_bar, ignore_button_bar, ignore_button_bar)
        }
        register_hotspot_callbacks(-(0x3e8), -(0x3e8), 0x1, 0x1, -1, -1, cursor_key_0)
        register_hotspot_callbacks(-(0x3e8), -(0x3e9), 0x1, 0x1, -1, -1, cursor_key_1)
        register_hotspot_callbacks(-(0x3e8), -(0x3ea), 0x1, 0x1, -1, -1, cursor_key_2)
        register_hotspot_callbacks(-(0x3e8), -(0x3eb), 0x1, 0x1, -1, -1, cursor_key_3)
        register_hotspot_callbacks(-(0x3e8), -(0x3f0), 0x1, 0x1, -1, -1, cursor_key_8)
        bind_hotspot_key(-(0x3e8), -(0x3e8), 0x1, 0x1, 0x0)
        bind_hotspot_key(-(0x3e8), -(0x3e9), 0x1, 0x1, 0x1)
        bind_hotspot_key(-(0x3e8), -(0x3ea), 0x1, 0x1, 0x2)
        bind_hotspot_key(-(0x3e8), -(0x3eb), 0x1, 0x1, 0x3)
        bind_hotspot_key(-(0x3e8), -(0x3f0), 0x1, 0x1, 0x8)
        if G[0xcf2f8] >= 0x0 {
            register_hotspot_callbacks(-(0x3e8), -(0x3ef), 0x1, 0x1, -1, -1, cursor_key_7)
            bind_hotspot_key(-(0x3e8), -(0x3ef), 0x1, 0x1, 0x7)
        }
        arm_hotspot_wait()
    }
    return
}
sub quick_save_button_enter {
    atomic {
        G[0xedd] = 0x1
        G[0xcf2f1] = 0x1
        draw_message_window()
    }
    return
}
sub quick_save_button_leave {
    atomic {
        G[0xedd] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub quick_save_button_click {
    atomic {
        if G[0x3a5e] & 0x1 {
            sfx_load(0x2d, 0x1)
            sfx_start(0x1)
        } else {
            G[0xedd] = 0x0
            G[0xcf2f3] = save_numbered_slot(0x3e7)
            G[0xedd] = 0x1
            sfx_load(0x2e, 0x1)
            sfx_start(0x1)
            draw_message_window()
        }
    }
    return
}
sub quick_load_button_enter {
    atomic {
        G[0xede] = 0x1
        G[0xcf2f1] = 0x2
        draw_message_window()
    }
    return
}
sub quick_load_button_leave {
    atomic {
        G[0xede] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub quick_load_button_click {
    query_numbered_save_metadata(out G[0xcf2f3], 0x3e7, out G[0xcf2f4], out G[0xcf2f4], out G[0xcf2f4], out G[0xcf2f4], out G[0xcf2f4], out G[0xcf2f4], out G[0xcf2f4])
    if G[0xcf2f3] == 0x0 {
        sfx_load(0x2e, 0x1)
        sfx_start(0x1)
        sleep(0x1f4)
        set_tick_presentation(0x0)
        suspend_adv_skip_service()
        note "savemesskip q-load"
        instruction_marker_noop()
        set_adv_wait_indicator_enabled(0x0)
        G[0xcf2f3] = load_numbered_slot_and_resume(0x3e7)
    }
    return
}
sub auto_button_enter {
    atomic {
        G[0xedf] = 0x1
        G[0xcf2f1] = 0x3
        draw_message_window()
    }
    return
}
sub auto_button_leave {
    atomic {
        G[0xedf] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub auto_button_click {
    atomic {
        G[0xed9] = get_auto_message()
        G[0xed9] = 0x1 - G[0xed9]
        set_auto_message(G[0xed9])
        draw_message_window()
    }
    return
}
sub read_skip_button_enter {
    atomic {
        G[0xee0] = 0x1
        G[0xcf2f1] = 0x4
        draw_message_window()
    }
    return
}
sub read_skip_button_leave {
    atomic {
        G[0xee0] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub read_skip_button_click {
    atomic {
        G[0xee0] = 0x0
        G[0xed9] = get_read_message_skip()
        G[0xed9] = 0x1 - G[0xed9]
        set_read_message_skip(G[0xed9])
        draw_message_window()
        set_anim_clock(0x64)
        mark_frame_yield()
        reset_message_skip_input()
    }
    return
}
sub skip_button_enter {
    atomic {
        G[0xee1] = 0x1
        G[0xcf2f1] = 0x5
        draw_message_window()
    }
    return
}
sub skip_button_leave {
    atomic {
        G[0xee1] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub skip_button_click {
    atomic {
        G[0xee1] = 0x0
        set_message_skip(0x1)
        draw_message_window()
        set_anim_clock(0x64)
        mark_frame_yield()
        reset_message_skip_input()
    }
    return
}
sub history_button_enter {
    atomic {
        G[0xee2] = 0x1
        G[0xcf2f1] = 0x6
        draw_message_window()
    }
    return
}
sub history_button_leave {
    atomic {
        G[0xee2] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub history_button_click {
    atomic {
        G[0xee2] = 0x0
        draw_message_window()
    }
    cancel_hotspot_wait()
    run HISTORY
    register_adv_hotspots()
    return
}
sub pin_button_enter {
    atomic {
        G[0xee3] = 0x1
        G[0xcf2f1] = 0x7
        draw_message_window()
    }
    return
}
sub pin_button_leave {
    atomic {
        G[0xee3] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub pin_button_click {
    atomic {
        G[0xee3] = 0x0
        G[0xed6] = 0x1 - G[0xed6]
        draw_message_window()
    }
    cancel_hotspot_wait()
    register_adv_hotspots()
    return
}
sub hide_button_enter {
    atomic {
        G[0xee4] = 0x1
        G[0xcf2f1] = 0x8
        draw_message_window()
    }
    return
}
sub hide_button_leave {
    atomic {
        G[0xee4] = 0x0
        G[0xcf2f1] = 0x0
        draw_message_window()
    }
    return
}
sub hide_button_click {
    atomic {
        G[0xee4] = 0x0
        draw_message_window()
    }
    yield_adv_coroutine()
    cancel_hotspot_wait()
    register_adv_hotspots()
    return
}
sub expand_button_bar {
    atomic {
        if G[0xed5] == 0x1 {
            cancel_hotspot_wait()
            for G[0xcf308] = 0x0; G[0xcf308] < 0xd; G[0xcf308] += 0x1 {
                set_anim_transform_abs(0x1e654 + G[0xcf308], 0x0, 0xc8, 0x0, 0x0, 0x0)
            }
            if G[0xed4] == 0x1 {
                gfx_blit_color(0x1e654 + 0x1, 0x0, 0xc8, 0x0, -(0x1))
            }
            mark_frame_yield()
            G[0xed5] = 0x2
            register_adv_hotspots()
        }
    }
    return
}
sub ignore_button_bar {
    return
}
sub collapse_button_bar {
    atomic {
        if G[0xed5] == 0x2 {
            cancel_hotspot_wait()
            for G[0xcf308] = 0x0; G[0xcf308] < 0xd; G[0xcf308] += 0x1 {
                set_anim_transform_abs(0x1e654 + G[0xcf308], 0x0, 0xc8, 0x64, 0x0, 0x0)
            }
            if G[0xed4] == 0x1 {
                gfx_blit_color(0x1e654 + 0x1, 0x0, 0xc8, 0xff, -(0x1))
            }
            mark_frame_yield()
            G[0xed5] = 0x1
            register_adv_hotspots()
        }
    }
collapse_button_bar_1:
    return
}
sub cursor_key_0 {
    if G[0xed5] == 0x2 {
        get_cursor_virtual(out G[0xedb], out G[0xedc])
        if G[0xedb] < 0x0 || G[0xedb] > 0x500 {
            G[0xedb] = 0x4d2
        }
        if G[0xedd] {
            set_cursor_virtual(G[0xedb], 0x208)
        } else if G[0xede] {
            if G[0x3a5e] & 0x1 {
                set_cursor_virtual(G[0xedb], 0x208)
            } else {
                set_cursor_virtual(G[0xedb], 0x230)
            }
        } else if G[0xedf] {
            if G[0xcf2f8] {
                set_cursor_virtual(G[0xedb], 0x208)
            } else {
                set_cursor_virtual(G[0xedb], 0x245)
            }
        } else if G[0xee0] {
            set_cursor_virtual(G[0xedb], 0x25a)
        } else if G[0xee1] {
            set_cursor_virtual(G[0xedb], 0x26f)
        } else if G[0xee2] {
            set_cursor_virtual(G[0xedb], 0x284)
        } else if G[0xee3] {
            set_cursor_virtual(G[0xedb], 0x299)
        } else {
            goto cursor_key_8
        }
    } else {
        goto cursor_key_8
    }
    return
cursor_key_1:
    if G[0xed5] == 0x1 || G[0xed6] == 0x1 {
        get_cursor_virtual(out G[0xedb], out G[0xedc])
        if G[0xedb] == 0x4d2 {
            G[0xedb] = 0x4d1
        } else {
            G[0xedb] = 0x4d2
        }
        if G[0xcf2f8] {
            set_cursor_virtual(G[0xedb], 0x25a)
        } else if G[0x3a5e] & 0x1 {
            set_cursor_virtual(G[0xedb], 0x245)
        } else {
            set_cursor_virtual(G[0xedb], 0x230)
        }
    } else if G[0xed5] == 0x2 {
        get_cursor_virtual(out G[0xedb], out G[0xedc])
        if G[0xedc] < 0x0 || G[0xedc] > 0x2d0 {
            G[0xedc] = 0x230
        }
        set_cursor_virtual(0x497, G[0xedc])
    }
    return
cursor_key_2:
    if G[0xed5] == 0x2 {
        get_cursor_virtual(out G[0xedb], out G[0xedc])
        if G[0xedb] < 0x0 || G[0xedb] > 0x500 {
            G[0xedb] = 0x4d2
        }
        if G[0xedd] {
            set_cursor_virtual(G[0xedb], 0x245)
        } else if G[0xede] {
            set_cursor_virtual(G[0xedb], 0x25a)
        } else if G[0xedf] {
            set_cursor_virtual(G[0xedb], 0x26f)
        } else if G[0xee0] {
            set_cursor_virtual(G[0xedb], 0x284)
        } else if G[0xee1] {
            set_cursor_virtual(G[0xedb], 0x299)
        } else if G[0xee2] {
            set_cursor_virtual(G[0xedb], 0x2af)
        } else if G[0xcf2f8] {
            set_cursor_virtual(0x4d2, 0x25a)
        } else if G[0x3a5e] & 0x1 {
            set_cursor_virtual(0x4d2, 0x245)
        } else {
            set_cursor_virtual(0x4d2, 0x230)
        }
        goto cursor_key_0_3
    }
    if G[0xed5] == 0x1 {
        if G[0xcf2f8] {
            set_cursor_virtual(0x4d2, 0x25a)
            goto cursor_key_0_3
        }
        if G[0x3a5e] & 0x1 {
            set_cursor_virtual(0x4d2, 0x245)
            goto cursor_key_0_3
        }
        set_cursor_virtual(0x4d2, 0x230)
    }
cursor_key_0_3:
    return
cursor_key_3:
    if G[0xed5] == 0x2 {
        get_cursor_virtual(out G[0xedb], out G[0xedc])
        if G[0xedc] < 0x0 || G[0xedc] > 0x2d0 {
            G[0xedc] = 0x230
        }
        set_cursor_virtual(0x497, G[0xedc])
        goto cursor_key_0_5
    }
    if G[0xed5] == 0x1 {
        if G[0xcf2f8] {
            set_cursor_virtual(0x4d2, 0x25a)
            goto cursor_key_0_5
        }
        if G[0x3a5e] & 0x1 {
            set_cursor_virtual(0x4d2, 0x245)
            goto cursor_key_0_5
        }
        set_cursor_virtual(0x4d2, 0x230)
    }
cursor_key_0_5:
    return
cursor_key_7:
    atomic {
        G[0xedd] = 0x0
        G[0xede] = 0x0
        G[0xedf] = 0x0
        G[0xee0] = 0x0
        G[0xee1] = 0x0
        G[0xee2] = 0x0
        G[0xee3] = 0x0
        G[0xee4] = 0x0
        G[0xcf2f1] = 0x0
        cancel_hotspot_wait()
    }
    if G[0xcf2f8] {
        GS[0x350][G[0xe7a25]] = set_string("シーン回想終了")
        G[0xe7a28][G[0xe7a25]] = G[0xe7a25]
        G[0xe7bcd] = G[0xe7a25]
        G[0xe7a25] += 0x1
        GS[0x350][G[0xe7a25]] = set_string("キャンセル")
        G[0xe7a28][G[0xe7a25]] = G[0xe7a25]
        G[0xe7bcd] = G[0xe7a25]
        G[0xe7a25] += 0x1
        G[0xe7bce] = 0x7
        run BUNKI
        if G[0xe7a27] == 0x0 {
            exit
        }
    } else {
        G[0xcf309] = 0x0
        run MENU
    }
    register_adv_hotspots()
    return
cursor_key_8:
    atomic {
        G[0xedd] = 0x0
        G[0xede] = 0x0
        G[0xedf] = 0x0
        G[0xee0] = 0x0
        G[0xee1] = 0x0
        G[0xee2] = 0x0
        G[0xee3] = 0x0
        G[0xee4] = 0x0
        G[0xcf2f1] = 0x0
        cancel_hotspot_wait()
    }
    run HISTORY
    register_adv_hotspots()
    return
}
coroutine adv_hide_window_handler {
    begin_window_transition()
    G[0xed3] = 0x0
    G[0xcf332] = 0x1f4
    fade_message_window()
    present_window_transition()
    cancel_hotspot_wait()
    run HIDEWIN
    if G[0xcf2fb] {
        atomic {
            redraw_message_window()
            present_frame()
            G[0xcf2fb] = 0x0
        }
    }
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    mark_save_resume_frame()
    yield_adv_coroutine()
    resume
}
coroutine adv_show_window_handler {
    begin_window_transition()
    G[0xed3] = 0x1
    draw_message_window()
    draw_nameplate()
    G[0xcf332] = 0x1f4
    fade_message_window()
    G[0x3a47] = 0x1
    present_window_transition()
    resume
}

// The library the scenes link, each behind an exit guard.
@guard sub draw_message_window {
    gfx_elem_erase(0x1e460, 0x4)
    gfx_elem_erase(0x1e654, 0xe)
    if G[0xed3] {
        if G[0xed4] == 0x0 {
            draw_texture(0x1e460, 0x11, 0x0, 0x41a, 0x373, 0xa0, 0x109, 0x21b)
            draw_texture(0x1e460 + 0x1, 0x11, 0x0, 0x34c, 0x24, 0xb0, 0x100, 0x213)
            draw_texture(0x1e460 + 0x2, 0x11, 0x361, 0x34c, 0x24, 0xb0, 0x461, 0x213)
            draw_texture(0x1e460 + 0x3, 0x11, 0x24, 0x3f3, 0x33d, 0x9, 0x124, 0x2ba)
