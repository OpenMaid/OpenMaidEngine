@guard sub place_layer_graphic {
    op_0x21a(G[0xcf312][G[0xcf30c]], out G[0xcf32a], out G[0xcf32b], out G[0xcf32c])
    op_0x218(G[0xcf312][G[0xcf30c]], out G[0xcf32d], out G[0xcf32e], out G[0xcf32f])
    G[0xcf30e] = op_0x215(G[0xcf312][G[0xcf30c]])
