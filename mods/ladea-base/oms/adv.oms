}
@guard sub set_message_text_origins {
    if G[0xed4] == 0x0 {
        set_adv_text_layout_origin(0x1, 0x109, 0x22a)
        set_adv_text_layout_origin(0x2, 0x130, 0x1fd)
        set_adv_text_bounds(0x1, 0x32 + 0x30c, 0xf + 0x82)
    } else if G[0xed4] == 0x1 {
        set_adv_text_layout_origin(0x1, 0x10e, 0x266)
        set_adv_text_layout_origin(0x2, -(0xa), 0x26c)
        set_adv_text_bounds(0x1, 0x32 + 0x30c, 0xf + 0x50)
