}
@guard sub begin_window_transition {
    atomic {
        return
        exit
    fade_message_window:
        if G[0xed3] {
            for G[0xcf308] = 0x0; G[0xcf308] < 0x4; G[0xcf308] += 0x1 {
                gfx_blit_color(0x1e460 + G[0xcf308], 0x0, G[0xcf332], -(0x1), -(0x1))
                gfx_draw_color(0x1e460 + G[0xcf308], 0x0, 0x0, -(0x1))
            }
            for G[0xcf308] = 0x0; G[0xcf308] < 0xe; G[0xcf308] += 0x1 {
                gfx_blit_color(0x1e654 + G[0xcf308], 0x0, G[0xcf332], -(0x1), -(0x1))
                gfx_draw_color(0x1e654 + G[0xcf308], 0x0, 0x0, -(0x1))
            }
            for G[0xcf308] = 0x0; G[0xcf308] < 0x4; G[0xcf308] += 0x1 {
                gfx_blit_color(0x1e4c4 + G[0xcf308], 0x0, G[0xcf332], -(0x1), -(0x1))
                gfx_draw_color(0x1e4c4 + G[0xcf308], 0x0, 0x0, -(0x1))
            }
            if G[0x3a4a] >= 0x0 {
                gfx_draw_color(0x1e3fc, 0x0, 0x0, -(0x1))
                gfx_blit_color(0x1e3fc, 0x0, G[0xcf332], 0xff, -(0x1))
            }
        } else {
            for G[0xcf308] = 0x0; G[0xcf308] < 0x4; G[0xcf308] += 0x1 {
                gfx_blit_color(0x1e460 + G[0xcf308], 0x0, G[0xcf332], 0x0, -(0x1))
            }
            for G[0xcf308] = 0x0; G[0xcf308] < 0xe; G[0xcf308] += 0x1 {
                gfx_blit_color(0x1e654 + G[0xcf308], 0x0, G[0xcf332], 0x0, -(0x1))
            }
            for G[0xcf308] = 0x0; G[0xcf308] < 0x4; G[0xcf308] += 0x1 {
                gfx_blit_color(0x1e4c4 + G[0xcf308], 0x0, G[0xcf332], 0x0, -(0x1))
            }
            if G[0x3a4a] >= 0x0 {
                gfx_blit_color(0x1e3fc, 0x0, G[0xcf332], 0x0, -(0x1))
            }
            G[0xedd] = 0x0
            G[0xede] = 0x0
            G[0xedf] = 0x0
            G[0xee0] = 0x0
            G[0xee1] = 0x0
            G[0xee2] = 0x0
            G[0xee3] = 0x0
            G[0xee4] = 0x0
            G[0xcf2f1] = 0x0
        }
        gfx_elem_erase(0x1e5f0, 0x1)
        clear_message_text()
        G[0xcf336] = 0x1
        return
        exit
    present_window_transition:
        set_tick_presentation(0x1)
        if G[0xcf336] {
            if G[0xcf361] {
                G[0xcf362] = 0x0
                for G[0xcf30c] = 0x0; G[0xcf30c] < 0xb; G[0xcf30c] += 0x1 {
                    if G[0xcf362] < G[0x3adb][G[0xcf30c]] {
                        G[0xcf362] = G[0x3adb][G[0xcf30c]]
                    }
                }
                if G[0xcf362] {
                    set_anim_clock(G[0xcf362])
                }
                G[0xcf361] = 0x0
            }
            G[0xcf2eb] = get_message_skip()
            G[0xcf2ec] = get_adv_read_skip_state()
            if G[0xcf2eb] | G[0xcf2ec] {
                reset_anim_clock()
                present_frame()
            } else {
                mark_frame_yield()
            }
            clear_gfx_command_queue()
            for G[0xcf30c] = 0x0; G[0xcf30c] <= 0xb; G[0xcf30c] += 0x1 {
                if G[0xcf312][G[0xcf30c]] {
                    G[0xcf30e] = op_0x215(G[0xcf312][G[0xcf30c]] + 0x1)
                    if G[0xcf30e] >= 0x0 {
                        gfx_elem_erase(G[0xcf312][G[0xcf30c]] + 0x1, 0x1)
                        G[0xe7a12] = op_0x215(G[0xcf312][G[0xcf30c]])
                        if G[0xcf30e] != G[0xe7a12] {
                            gfx_elem_release(G[0xcf30e])
                        }
                    }
                    G[0xcf30e] = op_0x215(G[0xcf312][G[0xcf30c]] + 0x2)
                    if G[0xcf30e] >= 0x0 {
                        gfx_draw_color(G[0xcf312][G[0xcf30c]], 0x0, -(0x1), -(0x1))
                        gfx_elem_erase(G[0xcf312][G[0xcf30c]] + 0x2, 0x1)
                        gfx_elem_release(G[0xcf30e])
                    }
                    if G[0xcf338][G[0xcf30c]] == 0x1 {
                        gfx_draw_color(G[0xcf312][G[0xcf30c]], 0x0, 0x0, -(0x1))
                        goto begin_window_transition_3
                    }
                    if G[0xcf338][G[0xcf30c]] == 0x2 {
                        gfx_draw_color(G[0xcf312][G[0xcf30c]], 0x0, -(0x1), -(0x1))
                    }
                }
            begin_window_transition_3:
            }
            G[0xcf336] = 0x0
            zero_int_range(G[0xcf338], 0x14)
            publish_message_text()
        }
        if G[0xcf337] {
            if G[0xcf337] & 0x1 {
                gfx_elem_erase(0x1e014, 0x2)
                gfx_elem_release(0x1)
                gfx_elem_release(0xa)
            }
            if G[0xcf337] & 0x2 {
                gfx_elem_erase(0x1dc90 + 0x1, 0x1)
                gfx_elem_release(0xb)
                if G[0xcf357] == 0x1 {
                    gfx_draw_color(0x1dc90, G[0x3b17], 0x0, -(0x1))
                }
            }
            if G[0xcf337] & 0x4 {
                for G[0xcf30c] = 0x0; G[0xcf30c] < 0xb; G[0xcf30c] += 0x1 {
                    if G[0xcf312][G[0xcf30c]] {
                        gfx_elem_erase(G[0xcf312][G[0xcf30c]] + 0x1, 0x1)
                        gfx_elem_release(G[0x3a62:0x3][G[0xcf30c]][0x2])
                        if G[0xcf34c][G[0xcf30c]] == 0x1 {
                            gfx_draw_color(G[0xcf312][G[0xcf30c]], 0x0, 0x0, -(0x1))
                        }
                    }
                }
            }
            G[0xcf337] = 0x0
            zero_int_range(G[0xcf34c], 0x14)
        }
        if G[0xcf360] {
            G[0xcf360] = 0x0
            if G[0x3b1c] == 0x0 {
                set_gfx_range_transform(0x0, 0x0, 0x0, 0x0, 0x0)
            }
        }
        zero_int_range(G[0x3adb], 0x14)
    }
    return
}
@guard sub redraw_message_window {
    draw_message_window()
    draw_nameplate()
    publish_message_text()
    return
}
@guard sub draw_nameplate {
    gfx_elem_erase(0x1e4c4, 0x4)
