// セリカ's two conditions that follow the goddess gauge G[0x7250] (character_condition_levels G[0x218c0:0x3c] and
// character_condition_turns G[0x247a0:0x3c], character 1): at a gauge of 400 or less, condition 46 (女神) at
// level (600 - gauge) / 200; at 601 or more, condition 47 (抑制) at level 2 - (1000 - gauge) / 200; each for good
// (turns -1). BTL, FIELD, INN and INITGAME set them by the same code (SC0000@0x2876d; five scenes link it).
@guard sub set_goddess_gauge_conditions {
    G[0x2192a] = 0x0
    G[0x2480a] = 0x0
    G[0x2192b] = 0x0
    G[0x2480b] = 0x0
    if G[0x7250] <= 0x190 {
        G[0x2192a] = (0x258 - G[0x7250]) / 0xc8
        G[0x2480a] = -(0x1)
    } else if G[0x7250] >= 0x259 {
        G[0x2192b] = 0x2 - (0x3e8 - G[0x7250]) / 0xc8
        G[0x2480b] = -(0x1)
    }
    return
}
