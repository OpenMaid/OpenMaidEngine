                } else {
                    draw_texture(0x1e654 + 0x2, 0x11, 0x39a + G[0xedd] * 0x53, 0x34c, 0x52, 0x13, 0x4a9, 0x226)
                }
                if G[0xcf2f8] == 0x1 {
                    draw_texture(0x1e654 + 0x3, 0x11, 0x440, 0x360, 0x52, 0x13, 0x4a9, 0x23b)
                } else {
                    draw_texture(0x1e654 + 0x3, 0x11, 0x39a + G[0xede] * 0x53, 0x360, 0x52, 0x13, 0x4a9, 0x23b)
                }
                draw_texture(0x1e654 + 0x4, 0x11, 0x39a + G[0xedf] * 0x53, 0x374, 0x52, 0x13, 0x4a9, 0x250)
                draw_texture(0x1e654 + 0x5, 0x11, 0x39a + G[0xee0] * 0x53, 0x388, 0x52, 0x13, 0x4a9, 0x265)
                draw_texture(0x1e654 + 0x6, 0x11, 0x39a + G[0xee1] * 0x53, 0x39c, 0x52, 0x13, 0x4a9, 0x27a)
                draw_texture(0x1e654 + 0x7, 0x11, 0x39a + G[0xee2] * 0x53, 0x3b0, 0x52, 0x13, 0x4a9, 0x28f)
                draw_texture(0x1e654 + 0x8, 0x11, 0x39a + G[0xee3] * 0x3f, 0x3c4 + G[0xed6] * 0x13, 0x3e, 0x12, 0x4bd, 0x2a5)
                draw_texture(0x1e654 + 0xd, 0x11, 0x45e + G[0xee4] * 0x1d, 0x414, 0x1c, 0x1c, 0x473, 0x2b0)
            } else {
                draw_texture(0x1e654 + 0x1, 0x11, 0x39a, 0x45f, 0x14, 0x8f, 0x488, 0x227)
                if G[0xed5] == 0x2 {
                    gfx_draw_color(0x1e654 + 0x1, 0x0, 0x0, -(0x1))
                }
                if G[0xcf2f8] == 0x1 || (G[0x3a5e] & 0x1) == 0x1 {
                    draw_texture(0x1e654 + 0x2, 0x11, 0x466, 0x45f, 0x50, 0x11, 0x4aa, 0x227)
                } else {
                    draw_texture(0x1e654 + 0x2, 0x11, 0x3c4 + G[0xedd] * 0x51, 0x45f, 0x50, 0x11, 0x4aa, 0x227)
                }
                if G[0xcf2f8] == 0x1 {
                    draw_texture(0x1e654 + 0x3, 0x11, 0x466, 0x471, 0x50, 0x11, 0x4aa, 0x23c)
                } else {
                    draw_texture(0x1e654 + 0x3, 0x11, 0x3c4 + G[0xede] * 0x51, 0x471, 0x50, 0x11, 0x4aa, 0x23c)
                }
                draw_texture(0x1e654 + 0x4, 0x11, 0x3c4 + G[0xedf] * 0x51, 0x483, 0x50, 0x11, 0x4aa, 0x251)
                draw_texture(0x1e654 + 0x5, 0x11, 0x3c4 + G[0xee0] * 0x51, 0x495, 0x50, 0x11, 0x4aa, 0x266)
                draw_texture(0x1e654 + 0x6, 0x11, 0x3c4 + G[0xee1] * 0x51, 0x4a7, 0x50, 0x11, 0x4aa, 0x27b)
                draw_texture(0x1e654 + 0x7, 0x11, 0x3c4 + G[0xee2] * 0x51, 0x4b9, 0x50, 0x11, 0x4aa, 0x290)
                draw_texture(0x1e654 + 0x8, 0x11, 0x41b + G[0xee3] * 0x3d, 0x4cb + G[0xed6] * 0x12, 0x3c, 0x10, 0x4bd, 0x2a6)
                draw_texture(0x1e654 + 0xd, 0x11, 0x3c4 + G[0xee4] * 0x1d, 0x4cb, 0x1c, 0x1c, 0x473, 0x2b0)
            }
            G[0xcf2ed] = get_auto_message()
            G[0xcf2eb] = get_message_skip_enabled()
            G[0xcf2ec] = get_read_message_skip()
            draw_texture(0x1e654 + 0x9, 0x11, 0x457 + G[0xcf2ed] * 0xd, 0x3c4, 0xc, 0xc, 0x4ea, 0x254)
            draw_texture(0x1e654 + 0xa, 0x11, 0x457 + G[0xcf2ec] * 0xd, 0x3c4, 0xc, 0xc, 0x4ea, 0x269)
            draw_texture(0x1e654 + 0xb, 0x11, 0x457 + G[0xcf2eb] * 0xd, 0x3c4, 0xc, 0xc, 0x4ea, 0x27e)
            draw_texture(0x1e654 + 0xc, 0x11, 0x457 + G[0xed6] * 0xd, 0x3c4, 0xc, 0xc, 0x4ea, 0x2a8)
            if G[0xed5] == 0x1 {
                gfx_set_translation_range(0x1e654, 0xd, 0x64, 0x0, 0x0)
