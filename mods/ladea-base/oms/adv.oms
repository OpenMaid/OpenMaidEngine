        }
    } else {
        G[0xedd] = 0x0
        G[0xede] = 0x0
        G[0xedf] = 0x0
        G[0xee0] = 0x0
        G[0xee1] = 0x0
        G[0xee2] = 0x0
        G[0xee3] = 0x0
        G[0xee4] = 0x0
        G[0xcf2f1] = 0x0
    }
    return
}
