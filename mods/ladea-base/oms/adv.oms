                draw_texture(0x1e4c4 + 0x1, 0x11, 0x52 + G[0x3a48] * 0x1d, 0x34c, 0x30f - G[0x3a48] * 0x1d, 0x9, 0x152 + G[0x3a48] * 0x1d, 0x213)
                draw_texture(0x1e4c4 + 0x2, 0x11, 0x0, 0x4be, 0x17 + G[0x3a48] * 0x1d, 0x30, 0x124, 0x1fb)
