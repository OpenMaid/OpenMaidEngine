oms 1
// 魔導巧殻 ADV prelude (spec §11.2): the speaker table, the dialogue line template, the scene header's handlers
// and the library its scenes link. Drafted 2026-11-26 from the core decompile of every SC and SP scene: the
// header from SC0000 (175 of 176 scenes carry it unchanged), each library sub from the first scene that
// links it. Its library is 創刻のアテリアル's, and its subs take Arterial's names; the families that differ only
// in a duration carry it in their names. Maintained by hand since.
module koukaku.adv
use koukaku.scripts

// Speaker ids: the index into CHINIT's names (GS[0x39e:0x6], a row of six name forms per character), the ones the
// scenes set. Names that are not identifiers carry their id.
enum speaker {
    ヴァイスハイト = 0x1
    リセル = 0x2
    アル = 0x3
    エイフェリア = 0x4
    リューン = 0x5
    オルファン = 0x6
    ナフカ = 0x7
    ガルムス = 0x8
    ベル = 0x9
    ジルタニア = 0xa
    ギュランドロス = 0xb
    ルイーネ = 0xc
    エルミナ = 0xd
    パティルナ = 0xe
    マルギレッタ = 0xf
    speaker_0x10 = 0x10  // リ・アネス
    フェイス = 0x11
    アルフィミア = 0x12
    ネネカ = 0x13
    クライス = 0x14
    ラクリール = 0x15
    フェルアノ = 0x16
    speaker_0x17 = 0x17  // エア・シアル
    エルファティシア = 0x18
    メイメイ = 0x19
    ダルマグナ = 0x1a
    ザルマグス = 0x1b
    コロナ = 0x1c
    ギルク = 0x1d
    ノイアス = 0x1e
    レクシュミ = 0x1f
    シーラ = 0x22
    アイシャ = 0x23
    ベルモン = 0x24
    リリエッタ = 0x25
    ハイシェラ = 0x28
    シュタイフェ = 0x29
    青年 = 0x5b
    アンナローツェ貴族 = 0x5d
    アンナローツェ兵 = 0x5e
    センタクス兵 = 0x5f
    センタクス部隊長 = 0x60
    speaker_0x61 = 0x61  // ユン・ガソル兵
    ザフハ獣人兵士 = 0x63
    商人 = 0x65
    speaker_0x69 = 0x69  // ユン・ガソルの将
    傭兵 = 0x6a
    男の子 = 0x6b
    女の子 = 0x6c
    エミリイ = 0x99
    フランシスカ = 0x9a
    モクラン = 0x9b
    ミリアーナ = 0x9c
    ミスティ = 0x9d
    コーネリア = 0xa3
    カイナッツ = 0xa4
    キルヒライア = 0xa5
    ケスラー = 0xa9
    クナイ = 0xaa
}

// One ADV page (spec §11.2). G[0x37d1]: the page has text. G[0x37d0] is the speaker (-1 for narration); the page
// draws its name from the speaker's row of CHINIT's names in the name form G[0x37d2] (a column 0 to 5; another
// value shows ？？？？; the scenes' few pages in form -1 stay core statements) and its face from the picture
// G[0x211c17] (-1 when the page passes none). G[0x211c18] is the voice, muted when the option for the speaker's voice
// character is off (G[0x33e7]).
@dialogue inline line(text: text, speaker: speaker = none, face: const = none, voice: const = none, form: const = 0x0) {
    set_tick_presentation(0x0)
    reset_adv_text_layout(0x2)
    reset_adv_text_layout(0x1)
    G[0x37d1] = 0x1
    begin_page_voice()
    static if speaker == none {
        atomic {
            clear_speaker_face()
            clear_speaker()
            arm_voice_duck_release()
            set_tick_presentation(0x1)
        }
    } else {
        atomic {
            G[0x37d0] = speaker
            G[0x37d2] = form
            static if face == none {
                G[0x211c17] = -(0x1)
            } else {
                G[0x211c17] = face
            }
            set_speaker_face()
            show_speaker()
            set_tick_presentation(0x1)
        }
    }
    static if voice != none {
        atomic {
            G[0x211c0d] = get_message_skip()
            G[0x211c0e] = get_adv_read_skip_state()
            if G[0x211c0d] | G[0x211c0e] {
                reset_message_voice_state()
                arm_voice_duck_release()
            }
            if G[0x37d0] < 0x0 {
                set_voice_bgm_duck_control(0x10001)
                G[0x211c90] = 0x0
            } else {
                set_voice_bgm_duck_control(0x0)
                if G[0x22af28][G[0x22ab40][G[0x37d0]]] {
                    G[0x22ab3f] = G[0x22af28][G[0x22ab40][G[0x37d0]]]
                } else if G[0x22d4d0][G[0x37d0]] == 0x2 {
                    G[0x22ab3f] = 0x2
                } else {
                    G[0x22ab3f] = 0x1
                }
                G[0x211c90] = G[0x22ab3f]
            }
            G[0x211c18] = voice
            append_text_history_metadata(0x4, G[0x211c90])
            append_text_history_metadata(0x5, G[0x211c18])
            if G[0x33e7][G[0x211c90]] == 0x0 {
                if G[0x211c0d] | G[0x211c0e] {
                    set_voice_bgm_duck_control(0x10001)
                    mute_next_voice()
                }
            } else {
                G[0x211c18] = 0x0
            }
            if G[0x211c18] {
                play_voice(G[0x211c18])
            } else {
                arm_voice_duck_release()
            }
        }
    }
    show_text(0x0, text)
    wait_for_input(0x0)
    end_text_line(0x0)
}

// The scene header's hotspot handlers and window coroutines: placed where each scene registers them, so the sidecar
// records their place.
sub register_adv_hotspots {
    atomic {
        if G[0xc5f] == 0x2 {
            if G[0x211c1a] == 0x0 {
                if (G[0x37e7] & 0x1) == 0x0 {
                    register_hotspot_callbacks(0x4b2, 0x1fd, 0x46, 0x11, quick_save_button_enter, quick_save_button_leave, quick_save_button_click)
                }
                register_hotspot_callbacks(0x4b2, 0x216, 0x46, 0x11, quick_load_button_enter, quick_load_button_leave, quick_load_button_click)
            }
            register_hotspot_callbacks(0x4b2, 0x22f, 0x46, 0x11, auto_button_enter, auto_button_leave, auto_button_click)
            register_hotspot_callbacks(0x4b2, 0x248, 0x46, 0x11, read_skip_button_enter, read_skip_button_leave, read_skip_button_click)
            register_hotspot_callbacks(0x4b2, 0x261, 0x46, 0x11, skip_button_enter, skip_button_leave, skip_button_click)
            register_hotspot_callbacks(0x4b2, 0x27a, 0x46, 0x11, history_button_enter, history_button_leave, history_button_click)
            register_hotspot_callbacks(0x4b2, 0x293, 0x46, 0x11, hide_button_enter, hide_button_leave, hide_button_click)
            register_hotspot_callbacks(0x49c, 0x1e5, 0x64, 0xdc, expand_button_bar, ignore_button_bar, ignore_button_bar)
            register_hotspot_callbacks(0x0, 0x0, 0x500, 0x2d0, collapse_button_bar, collapse_button_bar_1, collapse_button_bar_1)
        } else if G[0xc5f] == 0x1 {
            register_hotspot_callbacks(0x4d2, 0x1e5, 0x2e, 0xdc, expand_button_bar, ignore_button_bar, ignore_button_bar)
        }
        register_hotspot_callbacks(-(0x3e8), -(0x3e8), 0x1, 0x1, -1, -1, cursor_key_0)
        register_hotspot_callbacks(-(0x3e8), -(0x3e9), 0x1, 0x1, -1, -1, cursor_key_1)
        register_hotspot_callbacks(-(0x3e8), -(0x3ea), 0x1, 0x1, -1, -1, cursor_key_2)
        register_hotspot_callbacks(-(0x3e8), -(0x3eb), 0x1, 0x1, -1, -1, cursor_key_3)
        register_hotspot_callbacks(-(0x3e8), -(0x3f0), 0x1, 0x1, -1, -1, cursor_key_8)
        bind_hotspot_key(-(0x3e8), -(0x3e8), 0x1, 0x1, 0x0)
        bind_hotspot_key(-(0x3e8), -(0x3e9), 0x1, 0x1, 0x1)
        bind_hotspot_key(-(0x3e8), -(0x3ea), 0x1, 0x1, 0x2)
        bind_hotspot_key(-(0x3e8), -(0x3eb), 0x1, 0x1, 0x3)
        bind_hotspot_key(-(0x3e8), -(0x3f0), 0x1, 0x1, 0x8)
        if G[0x211c1a] >= 0x0 {
            register_hotspot_callbacks(-(0x3e8), -(0x3ef), 0x1, 0x1, -1, -1, cursor_key_7)
            bind_hotspot_key(-(0x3e8), -(0x3ef), 0x1, 0x1, 0x7)
        }
        arm_hotspot_wait()
    }
    return
}
sub quick_save_button_enter {
    atomic {
        G[0xc67] = 0x1
        G[0x211c13] = 0x1
        draw_message_window()
    }
    return
}
sub quick_save_button_leave {
    atomic {
        G[0xc67] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub quick_save_button_click {
    atomic {
        G[0xc67] = 0x0
        G[0x211c15] = save_numbered_slot(0x3e7)
        G[0xc67] = 0x1
        sfx_load(0x2f, 0x1)
        sfx_start(0x1)
        draw_message_window()
    }
    return
}
sub quick_load_button_enter {
    atomic {
        G[0xc68] = 0x1
        G[0x211c13] = 0x2
        draw_message_window()
    }
    return
}
sub quick_load_button_leave {
    atomic {
        G[0xc68] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub quick_load_button_click {
    query_numbered_save_metadata(out G[0x211c15], 0x3e7, out G[0x211c16], out G[0x211c16], out G[0x211c16], out G[0x211c16], out G[0x211c16], out G[0x211c16], out G[0x211c16])
    if G[0x211c15] == 0x0 {
        sfx_load(0x2f, 0x1)
        sfx_start(0x1)
        sleep(0x1f4)
        set_tick_presentation(0x0)
        suspend_adv_skip_service()
        note "savemesskip q-load"
        instruction_marker_noop()
        set_adv_wait_indicator_enabled(0x0)
        G[0x211c15] = load_numbered_slot_and_resume(0x3e7)
    }
    return
}
sub auto_button_enter {
    atomic {
        G[0xc69] = 0x1
        G[0x211c13] = 0x3
        draw_message_window()
    }
    return
}
sub auto_button_leave {
    atomic {
        G[0xc69] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub auto_button_click {
    atomic {
        G[0xc63] = get_auto_message()
        G[0xc63] = 0x1 - G[0xc63]
        set_auto_message(G[0xc63])
        draw_message_window()
    }
    return
}
sub read_skip_button_enter {
    atomic {
        G[0xc6a] = 0x1
        G[0x211c13] = 0x4
        draw_message_window()
    }
    return
}
sub read_skip_button_leave {
    atomic {
        G[0xc6a] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub read_skip_button_click {
    atomic {
        G[0xc6a] = 0x0
        G[0xc63] = get_read_message_skip()
        G[0xc63] = 0x1 - G[0xc63]
        set_read_message_skip(G[0xc63])
        draw_message_window()
        set_anim_clock(0x64)
        mark_frame_yield()
        reset_message_skip_input()
    }
    return
}
sub skip_button_enter {
    atomic {
        G[0xc6b] = 0x1
        G[0x211c13] = 0x5
        draw_message_window()
    }
    return
}
sub skip_button_leave {
    atomic {
        G[0xc6b] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub skip_button_click {
    atomic {
        G[0xc6b] = 0x0
        set_message_skip(0x1)
        draw_message_window()
        set_anim_clock(0x64)
        mark_frame_yield()
        reset_message_skip_input()
    }
    return
}
sub history_button_enter {
    atomic {
        G[0xc6c] = 0x1
        G[0x211c13] = 0x6
        draw_message_window()
    }
    return
}
sub history_button_leave {
    atomic {
        G[0xc6c] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub history_button_click {
    atomic {
        G[0xc6c] = 0x0
        draw_message_window()
    }
    cancel_hotspot_wait()
    run HISTORY
    register_adv_hotspots()
    return
}
sub hide_button_enter {
    atomic {
        G[0xc6d] = 0x1
        G[0x211c13] = 0x7
        draw_message_window()
    }
    return
}
sub hide_button_leave {
    atomic {
        G[0xc6d] = 0x0
        G[0x211c13] = 0x0
        draw_message_window()
    }
    return
}
sub hide_button_click {
    atomic {
        G[0xc6d] = 0x0
        draw_message_window()
    }
    yield_adv_coroutine()
    cancel_hotspot_wait()
    register_adv_hotspots()
    return
}
sub expand_button_bar {
    atomic {
        if G[0xc5f] == 0x1 {
            cancel_hotspot_wait()
            for G[0x211c2a] = 0x0; G[0x211c2a] < 0xa; G[0x211c2a] += 0x1 {
                set_anim_transform_abs(0xd4e4 + G[0x211c2a], 0x0, 0xc8, 0x0, 0x0, 0x0)
            }
            mark_frame_yield()
            G[0xc5f] = 0x2
            register_adv_hotspots()
        }
    }
    return
}
sub ignore_button_bar {
    return
}
sub collapse_button_bar {
    atomic {
        if G[0xc5f] == 0x2 {
            cancel_hotspot_wait()
            for G[0x211c2a] = 0x0; G[0x211c2a] < 0xa; G[0x211c2a] += 0x1 {
                set_anim_transform_abs(0xd4e4 + G[0x211c2a], 0x0, 0xc8, 0x5a, 0x0, 0x0)
            }
            mark_frame_yield()
            G[0xc5f] = 0x1
            register_adv_hotspots()
        }
    }
collapse_button_bar_1:
    return
}
sub cursor_key_0 {
    if G[0xc5f] == 0x2 {
        get_cursor_virtual(out G[0xc65], out G[0xc66])
        if G[0xc67] {
            set_cursor_virtual(G[0xc65], 0x1e0)
        } else if G[0xc68] {
            if G[0x37e7] & 0x1 {
                set_cursor_virtual(G[0xc65], 0x1e0)
            } else {
                set_cursor_virtual(G[0xc65], 0x205)
            }
        } else if G[0xc69] {
            if G[0x211c1a] {
                set_cursor_virtual(G[0xc65], 0x1e0)
            } else {
                set_cursor_virtual(G[0xc65], 0x21e)
            }
        } else if G[0xc6a] {
            set_cursor_virtual(G[0xc65], 0x237)
        } else if G[0xc6b] {
            set_cursor_virtual(G[0xc65], 0x250)
        } else if G[0xc6c] {
            set_cursor_virtual(G[0xc65], 0x269)
        } else if G[0xc6d] {
            set_cursor_virtual(G[0xc65], 0x282)
        } else {
            set_cursor_virtual(G[0xc65], 0x29b)
        }
    } else {
        goto cursor_key_8
    }
    return
cursor_key_1:
    if G[0xc5f] == 0x1 {
        if G[0x211c86] {
            set_cursor_virtual(0x4d5, 0x237)
        } else if G[0x37e7] & 0x1 {
            set_cursor_virtual(0x4d5, 0x21e)
        } else {
            set_cursor_virtual(0x4d5, 0x205)
        }
    } else if G[0xc5f] == 0x2 {
        get_cursor_virtual(out G[0xc65], out G[0xc66])
        set_cursor_virtual(0x497, G[0xc66])
    }
    return
cursor_key_2:
    if G[0xc5f] == 0x2 {
        get_cursor_virtual(out G[0xc65], out G[0xc66])
        if G[0xc67] {
            set_cursor_virtual(G[0xc65], 0x21e)
        } else if G[0xc68] {
            set_cursor_virtual(G[0xc65], 0x237)
        } else if G[0xc69] {
            set_cursor_virtual(G[0xc65], 0x250)
        } else if G[0xc6a] {
            set_cursor_virtual(G[0xc65], 0x269)
        } else if G[0xc6b] {
            set_cursor_virtual(G[0xc65], 0x282)
        } else if G[0xc6c] {
            set_cursor_virtual(G[0xc65], 0x29b)
        } else if G[0xc6d] {
            set_cursor_virtual(G[0xc65], 0x2c6)
        } else if G[0x211c86] {
            set_cursor_virtual(G[0xc65], 0x237)
        } else if G[0x37e7] & 0x1 {
            set_cursor_virtual(G[0xc65], 0x21e)
        } else {
            set_cursor_virtual(G[0xc65], 0x205)
        }
        goto cursor_key_0_3
    }
    if G[0xc5f] == 0x1 {
        if G[0x211c86] {
            set_cursor_virtual(0x4d5, 0x237)
            goto cursor_key_0_3
        }
        if G[0x37e7] & 0x1 {
            set_cursor_virtual(0x4d5, 0x21e)
            goto cursor_key_0_3
        }
        set_cursor_virtual(0x4d5, 0x205)
    }
cursor_key_0_3:
    return
cursor_key_3:
    if G[0xc5f] == 0x2 {
        get_cursor_virtual(out G[0xc65], out G[0xc66])
        set_cursor_virtual(0x497, G[0xc66])
        goto cursor_key_0_5
    }
    if G[0xc5f] == 0x1 {
        if G[0x211c86] {
            set_cursor_virtual(0x4d5, 0x237)
            goto cursor_key_0_5
        }
        if G[0x37e7] & 0x1 {
            set_cursor_virtual(0x4d5, 0x21e)
            goto cursor_key_0_5
        }
        set_cursor_virtual(0x4d5, 0x205)
    }
cursor_key_0_5:
    return
cursor_key_7:
    atomic {
        G[0xc67] = 0x0
        G[0xc68] = 0x0
        G[0xc69] = 0x0
        G[0xc6a] = 0x0
        G[0xc6b] = 0x0
        G[0xc6c] = 0x0
        G[0xc6d] = 0x0
        G[0x211c13] = 0x0
        cancel_hotspot_wait()
    }
    if G[0x211c1a] {
        GS[0x1b2][G[0x213f09]] = set_string("シーン回想終了")
        G[0x213f0c][G[0x213f09]] = G[0x213f09]
        G[0x2140b1] = G[0x213f09]
        G[0x213f09] += 0x1
        GS[0x1b2][G[0x213f09]] = set_string("キャンセル")
        G[0x213f0c][G[0x213f09]] = G[0x213f09]
        G[0x2140b1] = G[0x213f09]
        G[0x213f09] += 0x1
        G[0x2140b2] = 0x7
        run BUNKI
        if G[0x213f0b] == 0x0 {
            exit
        }
    } else {
        G[0x211c2b] = 0x0
        run MENU
    }
    register_adv_hotspots()
    return
cursor_key_8:
    atomic {
        G[0xc67] = 0x0
        G[0xc68] = 0x0
        G[0xc69] = 0x0
        G[0xc6a] = 0x0
        G[0xc6b] = 0x0
        G[0xc6c] = 0x0
        G[0xc6d] = 0x0
        G[0x211c13] = 0x0
        cancel_hotspot_wait()
    }
    run HISTORY
    register_adv_hotspots()
    return
}
coroutine adv_hide_window_handler {
    begin_window_transition()
    G[0xc5d] = 0x0
    G[0x211c54] = 0x1f4
    fade_message_window()
    for G[0x211c2a] = 0x0; G[0x211c2a] < 0x4; G[0x211c2a] += 0x1 {
        gfx_blit_color(0xcf08 + G[0x211c2a], 0x0, G[0x211c54], 0x0, -(0x1))
    }
    present_window_transition()
    cancel_hotspot_wait()
    run HIDEWIN
    if G[0x211c1d] {
        atomic {
            redraw_message_window()
            present_frame()
            G[0x211c1d] = 0x0
        }
    }
    coroutine_save_yield_handlers(adv_hide_window_handler, adv_show_window_handler)
    register_adv_hotspots()
    mark_save_resume_frame()
    yield_adv_coroutine()
    resume
}
coroutine adv_show_window_handler {
    begin_window_transition()
    G[0xc5d] = 0x1
    G[0x211c54] = 0x1f4
    fade_message_window()
    for G[0x211c2a] = 0x0; G[0x211c2a] < 0x4; G[0x211c2a] += 0x1 {
        gfx_draw_color(0xcf08 + G[0x211c2a], 0x0, 0x0, -(0x1))
        gfx_blit_color(0xcf08 + G[0x211c2a], 0x0, G[0x211c54], 0xff, -(0x1))
    }
    G[0x37d1] = 0x1
    present_window_transition()
    resume
}

// The library the scenes link, each behind an exit guard.
@guard sub draw_message_window {
    gfx_elem_erase(0xd2f0, 0x2)
    gfx_elem_erase(0xd2f0 + 0xa, 0x3)
    gfx_elem_erase(0xd4e4, 0xa)
    if G[0xc5d] {
        if G[0xc5e] == 0x0 {
            draw_texture(0xd2f0, 0x11, 0x0, 0x0, 0x500, 0xf8, 0x0, 0x1d8)
        } else if G[0xc5e] == 0x1 {
            draw_texture(0xd2f0, 0x11, 0x0, 0x0, 0x500, 0xf8, 0x0, 0x20a)
        } else if G[0xc5e] == 0x2 {
