@guard sub refresh_map {
    if G[0x19a328] {
        atomic {
            if G[0x0] == 0x1 {
                set_tick_presentation(0x0)
                begin_skip_suspension()
            }
            run SETMAP
            run READMAP
            run DRAWMAP
            G[0x19a328] = 0x0
            if G[0x0] == 0x1 {
                end_skip_suspension()
                set_tick_presentation(0x1)
            }
        }
    }
    return
}
@guard sub begin_skip_suspension {
    if G[0x211c8a] == 0x0 {
        suspend_adv_skip_service()
    }
    G[0x211c8a] += 0x1
    return
}
@guard sub end_skip_suspension {
    G[0x211c8a] -= 0x1
    if G[0x211c8a] == 0x0 {
        resume_adv_skip_service()
    }
    return
}
