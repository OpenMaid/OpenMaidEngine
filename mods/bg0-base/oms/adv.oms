oms 1
// 戦女神ZERO ADV prelude (spec §11.2): the speaker table, the dialogue line template, the scene header's handlers
// and the library its scenes link. Drafted 2026-11-25 from the core decompile of every SC and SP scene: the
// header from SC0000 (127 of 130 scenes carry it unchanged), each library sub from the first scene that
// links it, as many copies as one scene carries. Its library is Verita's first form, and its subs take Verita's
// names; what Verita made functions of (the page's voice start, the speaker's name plate) is inline in each page
// here. Maintained by hand since.
module bg0.adv
use bg0.scripts

// Speaker ids: the index into CNINIT's names (GS[0xe0]), the ones the scenes set. Names that are not
// identifiers (？？？？) and repeated names carry their id.
enum speaker {
    セリカ = 0x1
    speaker_0x2 = 0x2  // セリカ
    ハイシェラ = 0x3
    speaker_0x4 = 0x4  // セリカ
    ダルノス = 0xa
    神殿兵 = 0xd
    部隊長 = 0xe
    武装神官 = 0xf
    スフィーダ = 0x10
    ゲーエ = 0x11
    オレノ = 0x13
    司祭 = 0x14
    ストエルル = 0x15
    暗黒魔法を操る男 = 0x16
    迎えの水夫 = 0x19
    水夫 = 0x1a
    ガス = 0x24
