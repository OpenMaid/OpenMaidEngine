<Project Sdk="Microsoft.NET.Sdk">

  <!-- OME-Tool (modding from a release spec §6): the mod author's command line in a release, beside OME and
       OME-Launcher. It runs the commands Ome.Commands shares with Ome.Cli, with no checkout: the opcode metadata
       embedded in Ome.Engine, the game's toolchain from its shipped base mod, and the install a profile or
       the command line names. The release publishes it with NativeAOT (-p:PublishAot=true, as the engine). -->

  <ItemGroup>
    <ProjectReference Include="..\Ome.Commands\Ome.Commands.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OME-Tool</AssemblyName>
    <RootNamespace>Ome.Tool</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- cp932 and the other code pages the game's text needs, as in the engine (Ome.Engine registers the provider). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The version and commit stamps and the package notices of a release program (Directory.Build.targets); the
         tool's notices go in a folder of their own, as the launcher's do. -->
    <OmeProgram>true</OmeProgram>
    <OmePackageNoticeFolder>OME-Tool-notices</OmePackageNoticeFolder>
  </PropertyGroup>

  <!-- -p:OmeDependencyList=FILE keeps the build's dependency list, which a NativeAOT publish leaves out: the program
       holds the packages, and the release's notices check reads the list (tools/publish_engine.py). -->
  <Target Name="KeepDependencyList" AfterTargets="Publish" Condition="'$(OmeDependencyList)' != ''">
    <Error Condition="!Exists('$(ProjectDepsFilePath)')"
           Text="the build's dependency list was not found: $(ProjectDepsFilePath)" />
    <Copy SourceFiles="$(ProjectDepsFilePath)" DestinationFiles="$(OmeDependencyList)" />
  </Target>

</Project>
